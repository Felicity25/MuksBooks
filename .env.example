# Supabase Configuration (Cloud Migration)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# Application URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000  # Change to production domain for Vercel
NEXT_PUBLIC_SITE_NAME=MuksBooks

# Optional: AI Provider Settings
AI_PROVIDER=openai
OPENAI_API_KEY=replace-with-your-openai-key
OPENAI_MODEL=gpt-4o-mini

# Optional: Anthropic
ANTHROPIC_API_KEY=replace-with-your-claude-key
ANTHROPIC_MODEL=claude-3-5-sonnet-20240620

# Local development only (do not use in production)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/muksbooks?schema=public

# Supabase public configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-your-supabase-publishable-key
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-your-supabase-anon-key

# Supabase server-side configuration (do not expose in client code)
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
SUPABASE_JWT_SECRET=replace-with-jwt-secret

# App configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=MuksBooks
